function fncDATEIsichernDATEIbearbeiten {
    # -Variablen sind entweder schon definiert und gesetzt oder sie werden mittels
    #  $1 und $2 übergeben:
    #strDATEIname="$1"
    #strDATEIpfad="$2"
    strDATEIendungBAK=".bak.$zeitSTARTdateiname"
    
    echo -e "|- Sicherung der Datei erstellen..."
    echo -e "|- Name der Sicherung: $strDATEIname$strDATEIendungBAK"\\n"|-"
    #errDATEIcp=`cp /home/$nutzer/bin/$datei.conf /home/$nutzer/bin/testCP/$datei.conf.bak.$zeitSTARTdateiname`
    cp $strDATEIpfad$strDATEIname $strDATEIpfad$strDATEIname$strDATEIendungBAK 1>/dev/null 2>&1
    errDATEIcp=$?
    sleep 0.5
    if ( [[ "$errDATEIcp" -gt "0" ]] )
    then
        echo -e "|- FEHLER: Sicherung nicht erstellt! Bitte prüfen Sie die Zugriffsrechte innerhalb"
        echo -e "|- des Zielordners und Ihre eigenen Benutzerrechte. Das Skript wird jetzt beendet."\\n"|-"
        exit 1;
    else
        echo -e "|- Sicherung erfolgreich erstellt!"
        echo -e "|- Dateiname: $strDATEIname$strDATEIendungBAK"\\n"|-"
    fi
    
    echo -e "|- Datei bearbeiten:"
    echo -e "|- Befehl: 'vi $strDATEIpfad$strDATEIname'"
    vi $strDATEIpfad$strDATEIname
    errDATEIvi=$?
#     echo -e "|- Status: $errDATEIvi\\t0=Keine Fehler! Bearbeitung erfolgreich abgeschlossen."
#     echo -e "|-\\t\\t1=Fehler! Keine Rückmeldung über die Speichervorgänge. Bitte die Änderungen überprüfen!"
#     echo -e "|-\\t\\t2=Fehler! Bearbeitung wurde entweder durch Benutzer oder anderen Prozess abgebrochen."
    if ( [[ "$errDATEIvi" -gt "0" ]] )
    then
        echo -e "|- FEHLER: Keine Rückmeldung über den Speichervorgang. Sehr wahrscheinlich sind"
        echo -e "|- ungenügende Zugriffsrechte (Benutzer und/oder Verzeichnis) daran Schuld."
        echo -e "|- Bitte kontrollieren Sie die von Ihnen vorgenommenen Änderungen. Das Skript"
        echo -e "|- wird jetzt beendet."\\n"|-"
        exit 1;
    else
        echo -e "|- Datei erfolgreich gespeichert!"
        echo -e "|- Dateiname: $strDATEIname"\\n"|-"
    fi
    
    echo -e "|- Bearbeitung der Datei erfolgreich abgeschlossen!"\\n"|-"
}



