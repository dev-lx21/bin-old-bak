            if ( [[ "$arrSHORTCUTverzeichnisAUSWAHL" == "verzeichnisJA" ]] )
            then
                fncEINGABElogdatei
            else
                eingabeDATEI=$arrSHORTCUTverzeichnis"/"$dateiLOGS
            fi
        else
            fncEINGABElogdatei
        fi
        
        # -Pfad zur Logdatei übergeben, Daten ausgeben und Skript beenden:
        fncAUSGABElogdatei "$eingabeDATEI"
    fi
}







