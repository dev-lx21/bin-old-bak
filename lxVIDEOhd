for i in "$@"
do
    # -Stringparameter einzeln prüfen:
    #echo -e "--- $i ---"
    if ( [[ "$i" != "" ]] )
    then
        if ( [[ "$i" == "-h" ]] )
        then
            flagHILFE="true"
            break
        fi
        if ( [[ "$i" == "-l" ]] )
        then
            flagLOGS="true"
            break
        fi
        if ( [[ "$i" == -*t* ]] && [[ "$i" != -*tmv* ]] )
        then
            flagTESTDRIVE="true"
            txtTESTMODEtitel="TESTMODE"
            txtOPTIONENbefehl=$txtOPTIONENbefehl" -t"
        fi
        if ( [[ "$i" == -*tmv* ]] )
        then
            flagTESTDRIVE="true"
            flagTESTMODEmove="true"
            txtTESTMODEtitel="TESTMODE-MOVE"
            txtOPTIONENbefehl=$txtOPTIONENbefehl" -tmv"
        fi
        if ( [[ "$i" == -r ]] )
        then
            flagRENAME="true"
            txtOPTIONENbefehl=$txtOPTIONENbefehl" -r"
        fi
        if ( [[ "$i" == -v=* ]] )
        then
            flagFFMPGausgabe=${i//*=/}
            txtOPTIONENbefehl=$txtOPTIONENbefehl" $i"
        fi
        if ( [[ "$i" == "-UVZ" ]] )
        then
            flagUNTERVERZEICHNIS="true"
            flag_aufruf_intern="true"
            #echo -e "----- UVZ INTERN TRUE -----"
        fi
        if ( [[ "$i" != -* ]] )
            then
            #echo -e "--- String fängt nicht mit "-" an! ---"
            #echo -e "--- String ist keine Option, also Pfad! ---"
            pfad="$i"
            [ -z $pfad ] && pfad=`pwd`
            [[ "$pfad" != */ ]] && pfad=$pfad"/"
        fi
    fi
done
