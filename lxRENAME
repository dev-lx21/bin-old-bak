    echo -e "|- $datei - neuer Name: \\t$i"
    [[ "$iSICHERUNG" != "$i" ]] && mv "$iSICHERUNG" "$i"

    
    #`rename 's/[\-]+[a-z]*[a-z0-9]*[\.]+/\./g' "$i"`
    #i=${i//[\-]+[a-z]*[a-z0-9]*[\.]+/\.} ----- VORSICHT FEHLER
    
    # -da die eindeutige kennung am ende des dateinamens nun entfernt wird, muss
