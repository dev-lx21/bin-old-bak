#     `rename 's/\-ph[a-zA-Z0-9]\./\./g' "$i"`
#     i=${i//\-ph[a-zA-Z0-9]\./\.}

    
    # -mv Variante
    i=${i// /_}
    i=${i//[^a-zA-Z0-9_\-\.\/]/x}
    i=${i//_\-_YouTube/}
    i=${i//YouPorn_\-_/}
    i=${i//\-ph[a-zA-Z0-9]\./\.}
