function fncExtensionAendern {
  [[ -z "$2" ]] && echo -e "|- ${FUNCNAME[0]} FEHLER:"\\t"2. Argument nicht angegeben!" && return 12
  [[ -z "$3" ]] && echo -e "|- ${FUNCNAME[0]} FEHLER:"\\t"3. Argument nicht angegeben!" && return 12
  [[ -z "$4" ]] && echo -e "|- ${FUNCNAME[0]} FEHLER:"\\t"4. Argument nicht angegeben!" && return 12

  pfad="$2"
  strExtensionAlt="$3"
  strExtensionNeu="$4"

  [[ "$pfad" != */ ]] && pfad="$pfad""/"

  for ia in $(ls --group-directories-first $pfad)
    do
    nix=0
    #echo -e "-----------------------------------"
    #echo -e "-flag_aufruf_intern: $flag_aufruf_intern"
    #echo -e "-ia: $ia"
    #echo -e "-pfad: $pfad"

    cp -v $pfad$ia $pfad$ia".$strExtensionNeu"

    if ( [[ -d "$ia" ]] )
    then
      continue
    fi

    if ( [[ -f "$ia" ]] )
    then
      echo -e "--- $strExtensionAlt --> $strExtensionNeu"
      # -Alte Extension kontrollieren und dann durch Neue ersetzen:
      if ( [[ "$ia" == *."$strExtensionAlt" ]] )
      then
        echo -e "--- $strExtensionAlt --- $ia"
      fi
    fi


    #echo -e "...done - suchpfad: $suchpfad"
    # ende der ia schleife
  done
}


