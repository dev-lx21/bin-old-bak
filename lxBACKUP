            #[[ ! -d "$strCheckVerzeichnis" ]] && continue
            fncCheckVerzeichnis "$strCheckVerzeichnis" "true" "Ziel" "$txtAnzMaster" "$strCheckVerzeichnisZeitcode"
        done
        txtBefehlByteVerzeichnisseZiel="$txtBefehlByteVerzeichnisse"
