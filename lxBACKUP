        txtZEITSTEMPEL=`fncYEAR1231 'nurZAHLEN' && echo -en " " && fncHHMMSS 'norm.mS3'`
        fncECHOlx "|- $txtZEITSTEMPEL"
        
        fncAnzahlVerzeichnisse
        # +++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        # +++++ START for-ArrayZiel +++++++++++++++++++++++++++++++
