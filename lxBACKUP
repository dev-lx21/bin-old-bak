    intAnzMaster=intAnzMaster+1
    [[ "$intAnzMaster" -lt 10 ]] && txtAnzMaster="0$intAnzMaster""$txtAnzMasterTrenner" || txtAnzMaster="$intAnzMaster""$txtAnzMasterTrenner"
    fncAnzahlVerzeichnisse
    
    if ( [[ "$strg1" == -*l* ]] )
